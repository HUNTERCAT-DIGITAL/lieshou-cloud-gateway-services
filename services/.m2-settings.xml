<?xml version="1.0" encoding="UTF-8"?>
<!--
  lieshou-cloud · Maven 私服配置（唯一上游 = 内网 Nexus）
  - maven-public 是 group 仓：maven-releases（cn.huntercat 自有制品，如 framework-*） + maven-central 代理
  - 只 mirror，不需要凭证（匿名可读）；DEPLOY 的 <server> 由 CI / 本机 ~/.m2/settings.xml 提供
  - ⚠️ Nexus 由 Caddy **内部 CA** 签发 → 容器里必须先信任该 CA（见 Dockerfile 的 keytool 步骤）
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <name>Internal Nexus (maven-public)</name>
      <url>https://nexus.ts.huntercat.cn/repository/maven-public/</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
